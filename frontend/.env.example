# =========================
# Frontend Environment Example
# Alpha Data / Cyber OSINT Dashboard
# Copy this file to frontend/.env.local for local frontend development.
# Do not commit real .env.local files.
# =========================

# Explicit build identity. The build validates this value and injects the same
# non-secret identity into browser configuration.
APP_ENV=local

# Public frontend variable used by the browser to call the backend API.
# Only use NEXT_PUBLIC_ variables for values that are safe to expose.
# Local and test may omit it and use the bounded loopback fallback. Staging and
# production builds require an explicit non-loopback HTTPS URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
