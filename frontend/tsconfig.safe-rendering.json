{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "jsx": "react-jsx",
    "module": "Node16",
    "moduleResolution": "Node16",
    "noEmit": false,
    "rootDir": ".",
    "target": "ES2020",
    "types": ["node"]
  },
  "include": [
    "scripts/validate-safe-rendering.ts",
    "src/components/SafeExternalLink.tsx",
    "src/utils/safeExternalUrl.ts"
  ],
  "exclude": ["node_modules"]
}
