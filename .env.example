# =========================
# Cyber Sentinel / Cybersecurity OSINT Dashboard
# Root environment example
# Copy this file to .env for local Docker development.
# Do not commit real .env files.
# =========================

# PostgreSQL database configuration
# Docker services communicate using the Compose service name "db".
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=cyber_osint
POSTGRES_APP_USER=alpha_data_runtime
POSTGRES_BOOTSTRAP_USER=cyber_osint_bootstrap
POSTGRES_MIGRATION_USER=cyber_osint_migration

# First-run template markers only. When root .env is absent, .\run.cmd replaces
# all three with distinct cryptographically random local values before Docker
# starts. An existing .env is never overwritten, and these exact markers are
# rejected if they remain active there.
POSTGRES_PASSWORD=change-me-in-secret-store
POSTGRES_BOOTSTRAP_PASSWORD=change-me-in-secret-store
POSTGRES_MIGRATION_PASSWORD=change-me-in-secret-store

# Optional local Prefect metadata credentials. Compose retains internal-only
# compatibility fallbacks because changing these values after a metadata volume
# is initialized does not rotate its roles. Set unique values before the first
# Prefect start when managing them explicitly; never reuse production secrets.
# PREFECT_METADATA_ADMIN_PASSWORD=
# PREFECT_POSTGRES_PASSWORD=

# Optional full database URL override.
# When provided, DATABASE_URL explicitly takes precedence over the POSTGRES_*
# values above. Invalid DATABASE_URL values never fall back to components.
# Keep it blank unless the component settings cannot be used. See
# docs/environment-and-secrets.md for the structural format.
# DATABASE_URL=

# Bounded SQLAlchemy pool controls. These local defaults match application
# defaults; production may override only within the documented strict bounds.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_CONNECT_TIMEOUT_SECONDS=10

# Application ports
BACKEND_PORT=8000
FRONTEND_PORT=3000
# Prefect administration is always bound to 127.0.0.1 in local Compose.
PREFECT_PORT=4200

# Backend runtime
APP_NAME=Cyber Sentinel
APP_VERSION=0.1.0
APP_ENV=local
# Keep framework debug error pages disabled by default.
DEBUG=false
# Supported levels: DEBUG, INFO, WARNING, ERROR, CRITICAL. INFO is the safe
# default, including when APP_ENV=production.
LOG_LEVEL=INFO

# Frontend-to-backend connection
# The browser accesses the backend through the host-exposed port.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Exact comma-separated frontend origins allowed to call the backend in a browser.
# Wildcards, URL paths, control characters, user information, and empty entries
# are rejected. Production requires explicit non-loopback HTTPS origins.
BACKEND_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Exact Host header values accepted by the local backend. The testserver entry
# is restricted to the in-process FastAPI test client compatibility boundary.
BACKEND_TRUSTED_HOSTS=localhost,127.0.0.1,[::1],testserver

# Local opaque browser-session controls. Production must use secure cookies.
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_MINUTES=60
AUTH_SESSION_ABSOLUTE_TTL_MINUTES=480
AUTH_MAX_ACTIVE_SESSIONS=5
AUTH_LOGIN_FAILURE_LIMIT=5
AUTH_LOGIN_FAILURE_WINDOW_SECONDS=900
AUTH_LOGIN_BLOCK_SECONDS=900

# Optional manual-source configuration. A blank API key is valid when NVD
# ingestion is not being run. These settings do not schedule ingestion.
NVD_API_KEY=
FETCH_INTERVAL_MINUTES=30
ENABLE_ADMIN_INGESTION=false
