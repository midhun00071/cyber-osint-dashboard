# =========================
# Alpha Data / Cyber OSINT Dashboard
# Root environment example
# Copy this file to .env for local Docker development.
# Do not commit real .env files.
# =========================

# PostgreSQL database configuration
# Docker services communicate using the Compose service name "db".
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=cyber_osint
POSTGRES_USER=cyber_osint_app

# Local-development placeholder only.
# Replace this value in your real .env file.
POSTGRES_PASSWORD=change-me-in-secret-store

# Optional full database URL override.
# When provided, DATABASE_URL explicitly takes precedence over the POSTGRES_*
# values above. Invalid DATABASE_URL values never fall back to components.
# Keep it blank unless the component settings cannot be used. See
# docs/environment-and-secrets.md for the structural format.
# DATABASE_URL=

# Application ports
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Backend runtime
APP_NAME=Cyber OSINT Dashboard
APP_VERSION=0.1.0
APP_ENV=local
# Keep framework debug error pages disabled by default.
DEBUG=false
# Supported levels: DEBUG, INFO, WARNING, ERROR, CRITICAL. INFO is the safe
# default, including when APP_ENV=production.
LOG_LEVEL=INFO

# Frontend-to-backend connection
# The browser accesses the backend through the host-exposed port.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Exact comma-separated frontend origins allowed to call the backend in a browser.
# Wildcards, URL paths, control characters, user information, and empty entries
# are rejected. Production requires explicit non-loopback HTTPS origins.
BACKEND_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Exact Host header values accepted by the local backend. The testserver entry
# is restricted to the in-process FastAPI test client compatibility boundary.
BACKEND_TRUSTED_HOSTS=localhost,127.0.0.1,[::1],testserver

# Optional manual-source configuration. A blank API key is valid when NVD
# ingestion is not being run. These settings do not schedule ingestion.
NVD_API_KEY=
FETCH_INTERVAL_MINUTES=30
ENABLE_ADMIN_INGESTION=false
