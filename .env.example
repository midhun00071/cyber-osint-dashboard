# =========================
# Alpha Data / Cyber OSINT Dashboard
# Root environment example
# Copy this file to .env for local Docker development.
# Do not commit real .env files.
# =========================

# PostgreSQL database configuration
# Docker services communicate using the Compose service name "db".
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=cyber_osint
POSTGRES_USER=cyber_osint_app

# Local-development placeholder only.
# Replace this value in your real .env file.
POSTGRES_PASSWORD=replace_with_local_secret

# Optional full database URL override.
# When provided, DATABASE_URL takes precedence over the POSTGRES_* values above.
# DATABASE_URL=postgresql+psycopg://cyber_osint_app:replace_with_local_secret@db:5432/cyber_osint

# Application ports
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Backend runtime
APP_VERSION=0.1.0
APP_ENV=development
LOG_LEVEL=INFO

# Frontend-to-backend connection
# The browser accesses the backend through the host-exposed port.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
