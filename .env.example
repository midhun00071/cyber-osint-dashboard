# =========================
# Alpha Data / Cyber OSINT Dashboard
# Root environment example
# Copy this file to .env for local Docker development.
# Do not commit real .env files.
# =========================

# PostgreSQL database configuration
POSTGRES_USER=alpha_data_user
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=alpha_data_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Application ports
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Backend runtime
APP_ENV=development
LOG_LEVEL=INFO

# Frontend-to-backend connection
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
