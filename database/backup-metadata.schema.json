{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alpha-data.invalid/schemas/backup-metadata-v1.schema.json",
  "title": "Alpha Data logical backup metadata",
  "description": "Non-secret metadata contract for future B9-05 logical backup evidence. Conformance does not prove backup success or recoverability.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metadata_format_version",
    "backup_identifier",
    "database_system",
    "logical_backup_type",
    "started_utc",
    "completed_utc",
    "alembic_revision",
    "outcome_state",
    "encryption_state",
    "checksum_algorithm",
    "checksum_value",
    "artifact_size_bytes",
    "artifact_reference",
    "safe_summary"
  ],
  "properties": {
    "metadata_format_version": {
      "const": "1.0"
    },
    "backup_identifier": {
      "type": "string",
      "minLength": 16,
      "maxLength": 80,
      "pattern": "^backup_[A-Za-z0-9][A-Za-z0-9_-]{8,72}$"
    },
    "database_system": {
      "const": "postgresql"
    },
    "logical_backup_type": {
      "enum": ["pg_dump_custom", "pg_dump_directory"]
    },
    "started_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?Z$"
    },
    "completed_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?Z$"
    },
    "alembic_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{12}$"
    },
    "outcome_state": {
      "enum": ["succeeded", "failed", "cancelled"]
    },
    "encryption_state": {
      "enum": ["encrypted", "not_encrypted", "unknown"]
    },
    "checksum_algorithm": {
      "enum": ["sha256", "sha384", "sha512"]
    },
    "checksum_value": {
      "type": "string",
      "pattern": "^[0-9a-f]{64,128}$"
    },
    "artifact_size_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "artifact_reference": {
      "type": "string",
      "minLength": 21,
      "maxLength": 110,
      "pattern": "^artifact_ref_[A-Za-z0-9][A-Za-z0-9_-]{8,96}$"
    },
    "safe_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^[ -~]+$",
      "allOf": [
        {
          "not": {
            "pattern": "(?i)(password|passwd|secret|token|authorization|cookie|database[_ -]?url|connection[_ -]?string|postgres(?:ql)?://|traceback|stack trace|pg_dump|select[ ]|insert[ ]|update[ ]|delete[ ]|alter[ ]|drop[ ]|powershell|cmd\\.exe|/bin/(?:sh|bash)|[A-Za-z]:\\\\|(?:^|[ ])/(?:[^ ]+)|(?:[A-Za-z0-9-]+\\.)+[A-Za-z]{2,63}\\b|\\b[0-9]{1,3}(?:\\.[0-9]{1,3}){3}(?::[0-9]+)?\\b|\\b[A-Z][A-Z0-9_]{2,}=|\\b(?:psql|postgres|error|detail|hint):)"
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"checksum_algorithm": {"const": "sha256"}},
        "required": ["checksum_algorithm"]
      },
      "then": {"properties": {"checksum_value": {"pattern": "^[0-9a-f]{64}$"}}}
    },
    {
      "if": {
        "properties": {"checksum_algorithm": {"const": "sha384"}},
        "required": ["checksum_algorithm"]
      },
      "then": {"properties": {"checksum_value": {"pattern": "^[0-9a-f]{96}$"}}}
    },
    {
      "if": {
        "properties": {"checksum_algorithm": {"const": "sha512"}},
        "required": ["checksum_algorithm"]
      },
      "then": {"properties": {"checksum_value": {"pattern": "^[0-9a-f]{128}$"}}}
    }
  ]
}
