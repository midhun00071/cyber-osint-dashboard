{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alpha-data.invalid/schemas/prefect-backup-metadata-v1.schema.json",
  "title": "Alpha Data encrypted Prefect state backup metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata_format_version", "backup_identifier", "state_system", "state_format", "started_utc", "completed_utc", "outcome_state", "encryption_state", "checksum_algorithm", "checksum_value", "artifact_size_bytes", "artifact_reference", "safe_summary"],
  "properties": {
    "metadata_format_version": {"const": "1.0"},
    "backup_identifier": {"type": "string", "pattern": "^prefect_backup_[0-9]{8}t[0-9]{6}z_[a-f0-9]{8}$", "minLength": 40, "maxLength": 40},
    "state_system": {"const": "prefect"},
    "state_format": {"const": "prefect-3.8.1-volume-tar"},
    "started_utc": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"},
    "completed_utc": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"},
    "outcome_state": {"const": "succeeded"},
    "encryption_state": {"const": "encrypted"},
    "checksum_algorithm": {"const": "sha256"},
    "checksum_value": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact_size_bytes": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "artifact_reference": {"type": "string", "pattern": "^artifact_ref_prefect_backup_[0-9]{8}t[0-9]{6}z_[a-f0-9]{8}$", "minLength": 53, "maxLength": 53},
    "safe_summary": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "^[ -~]+$"}
  }
}
