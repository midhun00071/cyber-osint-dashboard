# C09 production example. Copy outside the repository, restrict permissions,
# and replace every required blank. Never commit a completed deployment file.

POSTGRES_DB=cyber_osint
POSTGRES_BOOTSTRAP_USER=replace_with_bootstrap_role
POSTGRES_APP_USER=replace_with_application_role
POSTGRES_MIGRATION_USER=replace_with_migration_role
POSTGRES_BACKUP_USER=replace_with_externally_provisioned_backup_login
POSTGRES_BOOTSTRAP_PASSWORD_SECRET_FILE=
POSTGRES_APP_PASSWORD_SECRET_FILE=
POSTGRES_MIGRATION_PASSWORD_SECRET_FILE=
POSTGRES_BACKUP_PASSWORD_SECRET_FILE=

DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_CONNECT_TIMEOUT_SECONDS=10
# Optional trustworthy database capacity. Leave blank to report storage unknown.
STORAGE_CAPACITY_BYTES=

EDGE_HOST=dashboard.example.invalid
EDGE_BIND_ADDRESS=0.0.0.0
EDGE_HTTP_PORT=80
EDGE_HTTPS_PORT=443
# Leave blank for normal public ACME in production. "internal" is local rehearsal only.
EDGE_TLS_MODE=
BACKEND_CORS_ALLOWED_ORIGINS=https://dashboard.example.invalid
BACKEND_TRUSTED_HOSTS=dashboard.example.invalid
NEXT_PUBLIC_API_BASE_URL=https://dashboard.example.invalid

APP_NAME=Cyber OSINT Dashboard
APP_VERSION=0.1.0
APP_COMMIT_SHA=
LOG_LEVEL=INFO
IMAGE_TAG=c09

AUTH_COOKIE_SECURE=true
AUTH_SESSION_TTL_MINUTES=60
AUTH_SESSION_ABSOLUTE_TTL_MINUTES=480
AUTH_MAX_ACTIVE_SESSIONS=5
AUTH_LOGIN_FAILURE_LIMIT=5
AUTH_LOGIN_FAILURE_WINDOW_SECONDS=900
AUTH_LOGIN_BLOCK_SECONDS=900

# Operational backup tooling references. Values are file/directory references,
# never secret material. The destination must exist outside this repository.
AGE_RECIPIENT_FILE=
AGE_IDENTITY_FILE=
BACKUP_DESTINATION_ROOT=
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=3

# External alert owner/provider/recipient remain approval-gated; no receiver
# credential is configured in C09.
