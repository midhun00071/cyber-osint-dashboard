# P7-01 production Compose example. Copy this file outside the repository and
# supply deployment-specific values. Never commit the completed file.

POSTGRES_DB=cyber_osint
POSTGRES_BOOTSTRAP_USER=replace_with_bootstrap_role
POSTGRES_APP_USER=replace_with_application_role
POSTGRES_MIGRATION_USER=replace_with_migration_role
# Absolute paths to separate protected regular files. Do not reuse production
# credentials between bootstrap, application, and migration identities.
POSTGRES_BOOTSTRAP_PASSWORD_SECRET_FILE=
POSTGRES_APP_PASSWORD_SECRET_FILE=
POSTGRES_MIGRATION_PASSWORD_SECRET_FILE=

# Optional bounded pool overrides.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_CONNECT_TIMEOUT_SECONDS=10

# Production requires explicit non-loopback HTTPS origins and trusted hosts.
BACKEND_CORS_ALLOWED_ORIGINS=https://dashboard.example.invalid
BACKEND_TRUSTED_HOSTS=api.example.invalid

# This public browser value is embedded when the frontend image is built.
NEXT_PUBLIC_API_BASE_URL=https://api.example.invalid

# Optional safe overrides.
APP_NAME=Cyber OSINT Dashboard
APP_VERSION=0.1.0
LOG_LEVEL=INFO
IMAGE_TAG=p7-01
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8000
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=3000

# Prefect publishes no host port in production. Its image, API address, fixed
# process work pool, and private network are not operator-configurable in B2-01.
