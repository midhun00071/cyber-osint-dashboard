# =========================
# Backend Environment Example
# Alpha Data / Cyber OSINT Dashboard
# Copy this file to backend/.env for local backend development.
# Do not commit real .env files.
# =========================

# Application settings
APP_NAME=Cyber OSINT Dashboard
APP_VERSION=0.1.0
APP_ENV=development
# Keep framework debug error pages disabled. Production rejects DEBUG=true.
DEBUG=false
# Supported levels: DEBUG, INFO, WARNING, ERROR, CRITICAL. INFO is the safe
# production default.
LOG_LEVEL=INFO

# Backend server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Database
# The example password is local-development placeholder text only.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cyber_osint
POSTGRES_USER=cyber_osint_app
POSTGRES_PASSWORD=replace_with_local_secret

# Optional full URL override. When provided, DATABASE_URL takes precedence over
# the POSTGRES_* component values above.
# DATABASE_URL=postgresql+psycopg://cyber_osint_app:replace_with_local_secret@localhost:5432/cyber_osint

# CORS
# Exact comma-separated browser origins. Do not use wildcards or URL paths.
# Production requires explicit non-loopback HTTPS origins such as:
# BACKEND_CORS_ALLOWED_ORIGINS=https://dashboard.example.com
BACKEND_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# External source configuration
# Do not place real API keys in this example file.
NVD_API_KEY=
FETCH_INTERVAL_MINUTES=30

# Security / admin controls
# Manual ingestion endpoints should remain disabled or protected in production.
ENABLE_ADMIN_INGESTION=true
