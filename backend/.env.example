# =========================
# Backend Environment Example
# Alpha Data / Cyber OSINT Dashboard
# Copy this file to backend/.env for local backend development.
# Do not commit real .env files.
# =========================

# Application settings
APP_NAME=Cyber OSINT Dashboard
APP_VERSION=0.1.0
APP_ENV=local
# Keep framework debug error pages disabled. Staging and production reject it.
DEBUG=false
# Supported levels: DEBUG, INFO, WARNING, ERROR, CRITICAL. INFO is the safe
# production default.
LOG_LEVEL=INFO

# Backend server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Database
# The example password is local-development placeholder text only.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cyber_osint
POSTGRES_USER=cyber_osint_app
POSTGRES_PASSWORD=change-me-in-secret-store

# Optional full URL override. When provided, DATABASE_URL explicitly takes
# precedence over the POSTGRES_* component values above; an invalid URL never
# falls back to components. See docs/environment-and-secrets.md
# for the structural format; never commit a credential-bearing URL.
# DATABASE_URL=

# CORS
# Exact comma-separated browser origins. Do not use wildcards or URL paths.
# Production requires explicit non-loopback HTTPS origins such as:
# BACKEND_CORS_ALLOWED_ORIGINS=https://dashboard.example.com
BACKEND_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Exact local Host header allow-list. Staging and production require explicit
# non-loopback values instead of this compatibility default.
BACKEND_TRUSTED_HOSTS=localhost,127.0.0.1,[::1],testserver

# External source configuration
# Do not place real API keys in this example file.
NVD_API_KEY=
FETCH_INTERVAL_MINUTES=30

# Security / admin controls
# Safe default. This setting does not schedule ingestion, and the current API
# exposes no ingestion route. Keep it false unless a future reviewed task adds
# and protects a manual administrative endpoint.
ENABLE_ADMIN_INGESTION=false
